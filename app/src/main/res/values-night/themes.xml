<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode window theme -->
    <style name="Theme.CallRecorder" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Theme.CallRecorder.Splash is NOT overridden here intentionally.
         It inherits from values/themes.xml which uses @drawable/splash_background —
         the same drawable works correctly in both light and dark modes. -->
</resources>
